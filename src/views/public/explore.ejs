<%- include('../partials/head', { title: 'Explore concours' }) %><%- include('../partials/public-nav') %>
<main class="container app-container page-shell">
  <p class="eyebrow">OPEN TO EVERYONE · OFFICIAL INFORMATION</p><h1 class="page-title">Explore concours</h1><p class="page-lede">Browse published concours before creating an account. Listings show available details and link back to the institution for confirmation.</p>
  <section class="panel p-3 p-md-4 mt-4 mb-4"><div class="row g-3 align-items-end"><div class="col-lg-8"><label class="form-label" for="exploreSearch">Search concours</label><input class="form-control" id="exploreSearch" type="search" placeholder="Concours, institution, programme or region" data-opportunity-search></div><div class="col-lg-4"><label class="form-label" for="exploreCategory">Category</label><select class="form-select" id="exploreCategory" data-opportunity-category><option value="all">All categories</option><% const categories = [...new Set(listings.map(({admissionOpportunity}) => admissionOpportunity.type).filter(Boolean))]; categories.forEach((category) => { %><option value="<%= category.toLowerCase() %>"><%= category %></option><% }) %></select></div></div><p class="small text-secondary mt-3 mb-0"><%= listings.length %> published <%= listings.length === 1 ? 'listing' : 'listings' %></p></section>
  <div class="row g-3">
    <% listings.forEach((session) => { const opportunity = session.admissionOpportunity; const programmes = opportunity.programmes || []; const institution = programmes[0]?.department?.school?.institution; const searchable = [opportunity.name, opportunity.type, institution?.name, institution?.location, institution?.region, ...programmes.map((programme) => programme.name)].filter(Boolean).join(' ').toLowerCase(); %>
      <div class="col-xl-6" data-opportunity-card data-search="<%= searchable %>" data-category="<%= (opportunity.type || '').toLowerCase() %>"><article class="panel opportunity-card"><div class="d-flex gap-3"><div class="org-chip"><%= (institution?.acronymn || institution?.name || opportunity.name).slice(0,3).toUpperCase() %></div><div class="flex-grow-1"><div class="d-flex flex-wrap justify-content-between gap-2"><span class="eyebrow"><%= institution?.name || 'Institution not specified' %></span><span class="status-pill"><%= session.status %></span></div><h2 class="panel-heading h5 mt-2 mb-1"><a class="stretched-link text-decoration-none" href="/explore/<%= session._id %>"><%= opportunity.name %></a></h2><p class="text-secondary small mb-2"><%= opportunity.type %><% if(institution?.location) { %> · <%= institution.location %><% } %><% if(institution?.region) { %> · <%= institution.region %><% } %></p><% if(programmes.length) { %><p class="small mb-2"><strong>Programmes:</strong> <%= programmes.map((programme) => programme.name).join(', ') %></p><% } %><div class="border-top pt-3 mt-3 small"><span class="text-secondary">Application deadline</span> <strong class="ms-2"><%= session.applicationDeadline ? new Date(session.applicationDeadline).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : 'Not published' %></strong></div></div></div></article></div>
    <% }) %>
  </div>
  <div class="panel empty-state mt-3" data-empty-results <%= listings.length ? 'hidden' : '' %>><span class="feature-icon mx-auto">⌕</span><h2 class="panel-heading h4 mt-3"><%= listings.length ? 'No matches found' : 'No published concours yet' %></h2><p><%= listings.length ? 'Try another search or category.' : 'Published listings will appear here when institutions and sessions are added.' %></p><% if(!listings.length) { %><a href="/register" class="btn btn-forest">Create an account</a><% } %></div>
  <div class="notice-callout mt-4"><strong>Information service only:</strong> ConcoursHub does not accept or process applications. Check the institution’s official source for current requirements, dates and application instructions.</div>
</main><%- include('../partials/footer') %>
