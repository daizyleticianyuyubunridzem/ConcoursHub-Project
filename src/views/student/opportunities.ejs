<%- include('../partials/head', { title: 'Find a concours' }) %>
<%- include('../partials/student-nav', { active: 'opportunities' }) %>
<main class="container app-container page-shell">
  <p class="eyebrow">OFFICIAL INFORMATION, IN ONE PLACE</p><h1 class="page-title">Find a concours</h1><p class="page-lede">Explore published entrance information and key dates. Check the institution’s official source for the latest details.</p>
  <section class="panel p-3 p-md-4 mt-4 mb-4"><div class="row g-3 align-items-end"><div class="col-lg-8"><label class="form-label" for="opportunitySearch">Search listings</label><input class="form-control" id="opportunitySearch" type="search" placeholder="Search by concours, institution, programme…" data-opportunity-search></div><div class="col-lg-4"><label class="form-label" for="opportunityCategory">Area</label><select class="form-select" id="opportunityCategory" data-opportunity-category><option value="all">All areas</option><% const types = [...new Set(listings.map(({session}) => session.admissionOpportunity.type).filter(Boolean))]; types.forEach((type) => { %><option value="<%= type.toLowerCase() %>"><%= type %></option><% }) %></select></div></div><p class="small text-secondary mt-3 mb-0"><%= listings.length %> published <%= listings.length === 1 ? 'listing' : 'listings' %></p></section>
  <div class="row g-3" id="opportunityResults">
    <% listings.forEach(({session, savedId}) => { const opportunity = session.admissionOpportunity; const programmes = opportunity.programmes || []; const institution = programmes[0]?.department?.school?.institution; const searchable = [opportunity.name, opportunity.type, institution?.name, institution?.location, institution?.region, ...programmes.map((p) => p.name)].filter(Boolean).join(' ').toLowerCase(); %>
      <div class="col-xl-6" data-opportunity-card data-search="<%= searchable %>" data-category="<%= (opportunity.type || '').toLowerCase() %>"><article class="panel opportunity-card"><div class="d-flex gap-3"><div class="org-chip"><%= (institution?.acronymn || institution?.name || opportunity.name).slice(0,3).toUpperCase() %></div><div class="flex-grow-1"><div class="d-flex flex-wrap justify-content-between gap-2"><span class="eyebrow"><%= institution?.name || 'Institution not specified' %></span><span class="status-pill"><%= session.status %></span></div><h2 class="panel-heading h5 mt-2 mb-1"><a class="stretched-link text-decoration-none" href="/student/opportunities/<%= session._id %>"><%= opportunity.name %></a></h2><p class="text-secondary small mb-2"><%= opportunity.type %><% if(institution?.location) { %> · <%= institution.location %><% } %><% if(institution?.region) { %> · <%= institution.region %><% } %></p><% if(programmes.length) { %><p class="small mb-2"><strong>Programmes:</strong> <%= programmes.map((p) => p.name).join(', ') %></p><% } %><div class="d-flex flex-wrap align-items-center justify-content-between border-top pt-3 mt-3 gap-2"><span class="small"><span class="text-secondary">Key date</span> <strong class="ms-2"><%= session.applicationDeadline ? new Date(session.applicationDeadline).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : 'Not published' %></strong></span><button type="button" class="btn btn-sm btn-outline-forest position-relative" data-save-opportunity data-opportunity-id="<%= opportunity._id %>" data-saved-id="<%= savedId || '' %>" aria-pressed="<%= savedId ? 'true' : 'false' %>"><%= savedId ? 'Saved' : 'Save concours' %></button></div></div></div></article></div>
    <% }) %>
  </div>
  <div class="panel empty-state mt-3" data-empty-results <%= listings.length ? 'hidden' : '' %>><span class="feature-icon mx-auto">⌕</span><h2 class="panel-heading h4 mt-3">No published listings yet</h2><p>New concours information will appear here when it has been published.</p></div>
  <p class="small text-secondary mt-3" data-save-status aria-live="polite"></p>
</main>
<%- include('../partials/footer') %>
