<%- include('../partials/head', { title: 'Saved concours' }) %>
<%- include('../partials/student-nav', { active: 'saved' }) %>
<main class="container app-container page-shell"><p class="eyebrow">KEEP YOUR OPTIONS CLOSE</p><h1 class="page-title">Saved concours</h1><p class="page-lede">A short list of the opportunities you want to revisit.</p>
  <% if(listings.length) { %><div class="row g-3 mt-2"><% listings.forEach(({session,savedId}) => { const opportunity=session.admissionOpportunity; const programme=opportunity.programmes?.[0]; const institution=programme?.department?.school?.institution; %><div class="col-xl-6" data-opportunity-card><article class="panel opportunity-card"><div class="d-flex gap-3"><div class="org-chip"><%= (institution?.acronymn || opportunity.name).slice(0,3).toUpperCase() %></div><div class="flex-grow-1"><span class="eyebrow"><%= institution?.name || 'Institution not specified' %></span><h2 class="panel-heading h5 mt-2"><a class="stretched-link text-decoration-none" href="/student/opportunities/<%= session._id %>"><%= opportunity.name %></a></h2><p class="small text-secondary"><%= opportunity.type %> · <%= session.academicYear %></p><div class="border-top pt-3 d-flex justify-content-between align-items-center"><span class="small"><span class="text-secondary">Deadline</span> <strong><%= session.applicationDeadline ? new Date(session.applicationDeadline).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : 'Not published' %></strong></span><button class="btn btn-sm btn-outline-forest position-relative" type="button" data-save-opportunity data-remove-after-save data-opportunity-id="<%= opportunity._id %>" data-saved-id="<%= savedId %>" aria-pressed="true">Remove</button></div></div></div></article></div><% }) %></div><% } %><section class="panel empty-state mt-4" data-saved-empty <%= listings.length ? 'hidden' : '' %>><span class="feature-icon mx-auto">☆</span><h2 class="panel-heading h4 mt-3">Nothing saved just yet</h2><p>When a concours catches your attention, save it here to find it again.</p><a class="btn btn-forest" href="/student/opportunities">Explore concours</a></section>
  <p class="small text-secondary mt-3" data-save-status aria-live="polite"></p>
</main><%- include('../partials/footer') %>
