<%- include('../partials/head', { title: session.admissionOpportunity.name }) %>
<%- include('../partials/student-nav', { active: 'opportunities' }) %>
<% const opportunity = session.admissionOpportunity; const programmes = opportunity.programmes || []; const institution = programmes[0]?.department?.school?.institution; const officialCandidate = opportunity.officialSource || institution?.website || ''; const officialUrl = /^https?:\/\//i.test(officialCandidate) ? officialCandidate : ''; const applicationUrl = /^https?:\/\//i.test(session.officialApplicationUrl || '') ? session.officialApplicationUrl : ''; %>
<main class="container app-container page-shell">
  <a class="small text-decoration-none" href="/student/opportunities">← Back to concours</a><div class="row g-4 mt-1"><div class="col-lg-8">
    <p class="eyebrow mt-3"><%= institution?.name || 'Institution not specified' %></p><h1 class="page-title"><%= opportunity.name %></h1><p class="page-lede"><%= opportunity.description || 'No additional description has been published for this concours.' %></p>
    <section class="panel p-4 mt-4"><h2 class="panel-heading h4">Session information</h2><dl class="row detail-list mt-3 mb-0"><dt class="col-sm-4">Academic year</dt><dd class="col-sm-8"><%= session.academicYear %></dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8"><%= session.status %></dd><dt class="col-sm-4">Applications open</dt><dd class="col-sm-8"><%= session.applicationStartDate ? new Date(session.applicationStartDate).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) : 'Not published' %></dd><dt class="col-sm-4">Application deadline</dt><dd class="col-sm-8"><%= session.applicationDeadline ? new Date(session.applicationDeadline).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) : 'Not published' %></dd><dt class="col-sm-4">Examination date</dt><dd class="col-sm-8"><%= session.examinationDate ? new Date(session.examinationDate).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) : 'Not published' %></dd><% if(institution?.location) { %><dt class="col-sm-4">Location</dt><dd class="col-sm-8"><%= institution.location %></dd><% } %></dl></section>
    <section class="panel p-4 mt-3"><h2 class="panel-heading h4">Published requirements</h2><p class="small text-secondary">Requirements shown here reflect information recorded for this session.</p><% if (requirements.length) { %><ul class="list-group list-group-flush"><% requirements.forEach((requirement) => { %><li class="list-group-item px-0 py-3"><div class="d-flex justify-content-between gap-3"><strong><%= requirement.name %></strong><span class="status-pill"><%= requirement.isMandatory ? 'Mandatory' : 'Additional' %></span></div><% if(requirement.description) { %><p class="small text-secondary mt-2 mb-0"><%= requirement.description %></p><% } %><% if(requirement.subject) { %><p class="small mt-2 mb-0"><%= requirement.subject %><%= requirement.level ? ` · ${requirement.level === 'o_level' ? 'O-Level' : 'A-Level'}` : '' %><%= requirement.minimumGrade ? ` · minimum grade ${requirement.minimumGrade}` : '' %></p><% } %><% if(requirement.requiredSeries) { %><p class="small mt-2 mb-0">Required series: <%= requirement.requiredSeries %></p><% } %></li><% }) %></ul><% } else { %><div class="empty-state py-4">Requirements have not been published in ConcoursHub for this session yet.</div><% } %></section>
  </div><aside class="col-lg-4"><div class="panel p-4 mt-lg-3"><h2 class="panel-heading h5">Your next steps</h2><p class="small text-secondary">Use your profile to compare your details with the requirements currently recorded.</p><a class="btn btn-forest w-100" href="/student/eligibility/<%= session._id %>">Check requirements fit</a><button class="btn btn-outline-forest w-100 mt-2" type="button" data-save-opportunity data-opportunity-id="<%= opportunity._id %>" data-saved-id="<%= savedId || '' %>" aria-pressed="<%= savedId ? 'true' : 'false' %>"><%= savedId ? 'Saved' : 'Save concours' %></button><div class="notice-callout mt-3">This comparison is guidance only. It is not an eligibility decision or an application.</div><hr><h3 class="panel-heading h6">Official information</h3><% if(officialUrl) { %><a class="d-block small" href="<%= officialUrl %>" target="_blank" rel="noopener noreferrer">Visit official source ↗</a><% } else { %><p class="small text-secondary">An official information link has not been provided.</p><% } %><% if(applicationUrl) { %><a class="btn btn-sm btn-outline-forest w-100 mt-3" href="<%= applicationUrl %>" target="_blank" rel="noopener noreferrer">Continue to institution’s application page ↗</a><p class="form-text mt-2">Applications are handled by the institution, not ConcoursHub.</p><% } %></div></aside></div>
</main>
<p class="container app-container small text-secondary" data-save-status aria-live="polite"></p><%- include('../partials/footer') %>
