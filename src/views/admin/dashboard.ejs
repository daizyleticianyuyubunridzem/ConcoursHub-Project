<%- include('../partials/head', { title: 'Administration' }) %><%- include('../partials/admin-nav', { active }) %>
<main class="container-fluid app-container page-shell"><p class="eyebrow">ADMIN WORKSPACE · CAMEROON PILOT</p><h1 class="page-title">Good work starts with reliable information.</h1><p class="page-lede">Manage the institutions, concours details and dates students use to plan their preparation.</p>
  <div class="row g-3 mt-3"><% const cards=[['institutions','Institutions','institutions','⌂'],['schools','Schools','schools','▤'],['programmes','Programmes','programmes','▣'],['opportunities','Concours','opportunities','⌕'],['sessions','Application sessions','sessions','◷'],['requirements','Requirements','requirements','✓'],['students','Student profiles','users','◎']]; cards.forEach(([key,label,path,icon])=>{ %><div class="col-6 col-lg-3"><a class="panel admin-stat d-block p-3 p-lg-4 h-100 text-decoration-none" href="/admin/<%= path === 'dashboard' ? '' : path %>"><span class="feature-icon"><%= icon %></span><span class="admin-stat-value"><%= counts[key] %></span><span class="admin-stat-label"><%= label %></span><span class="small text-forest fw-semibold">Manage →</span></a></div><% }) %></div>
  <section class="panel p-4 mt-4"><div class="d-flex flex-wrap justify-content-between align-items-start gap-3"><div><h2 class="panel-heading h4">A publishing reminder</h2><p class="text-secondary mb-0">ConcoursHub informs students. Applications remain with each institution.</p></div><span class="status-pill">VERIFY BEFORE PUBLISHING</span></div><p class="small text-secondary mt-3 mb-0">Use the official institution source for requirements, application URLs and dates. Leave unconfirmed details unpublished.</p></section>
</main><%- include('../partials/footer') %>
