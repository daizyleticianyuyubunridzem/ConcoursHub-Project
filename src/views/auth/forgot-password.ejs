<%- include('../partials/head', { title: 'Forgot password' }) %>
<%- include('../partials/public-nav') %>
<main class="auth-page"><section class="panel auth-card">
  <p class="eyebrow mb-2">ACCOUNT ACCESS</p>
  <h1>Reset your password.</h1>
  <p class="text-secondary">Enter the email address on your student account and we’ll send a password reset link.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger py-2 small" role="alert"><%= error %></div><% } %>
  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success py-2 small" role="status"><%= success %></div><% } %>
  <form action="/forgot-password" method="post" class="mt-4">
    <div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required></div>
    <button class="btn btn-forest w-100 mt-2" type="submit">Send reset link</button>
  </form>
  <p class="small text-center mt-4 mb-0"><a href="/login">Back to sign in</a></p>
</section></main>
<%- include('../partials/footer') %>
