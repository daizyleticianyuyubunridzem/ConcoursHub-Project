<%- include('../partials/head', { title: 'Sign in' }) %>
<%- include('../partials/public-nav') %>
<main class="auth-page"><section class="panel auth-card">
  <p class="eyebrow mb-2">WELCOME BACK</p><h1>Pick up where you left off.</h1><p class="text-secondary">Sign in to review your saved concours and study plan.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger py-2 small" role="alert"><%= error %></div><% } %>
  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success py-2 small" role="status"><%= success %></div><% } %>
  <form action="/login" method="post" class="mt-4">
    <div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" required></div>
    <div class="mb-3"><div class="d-flex justify-content-between align-items-center"><label class="form-label" for="password">Password</label><a class="small mb-2" href="/forgot-password">Forgot password?</a></div><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required></div>
    <button class="btn btn-forest w-100 mt-2" type="submit">Sign in</button>
  </form><p class="small text-center mt-4 mb-0">New to ConcoursHub? <a href="/register">Create an account</a></p>
</section></main>
<%- include('../partials/footer') %>
