<%- include('../partials/head', { title: 'Choose a new password' }) %>
<%- include('../partials/public-nav') %>
<main class="auth-page"><section class="panel auth-card">
  <p class="eyebrow mb-2">ACCOUNT ACCESS</p>
  <h1>Choose a new password.</h1>
  <p class="text-secondary">Use at least six characters, then sign in with your new password.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger py-2 small" role="alert"><%= error %></div><% } %>
  <% if (!(typeof invalid !== 'undefined' && invalid)) { %>
  <form action="/reset-password/<%= token %>" method="post" class="mt-4">
    <div class="mb-3"><label class="form-label" for="password">New password</label><input class="form-control" id="password" name="password" type="password" autocomplete="new-password" minlength="6" required></div>
    <div class="mb-3"><label class="form-label" for="confirmPassword">Confirm new password</label><input class="form-control" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required></div>
    <button class="btn btn-forest w-100 mt-2" type="submit">Update password</button>
  </form>
  <% } else { %><a class="btn btn-forest w-100 mt-3" href="/forgot-password">Request a new reset link</a><% } %>
  <p class="small text-center mt-4 mb-0"><a href="/login">Back to sign in</a></p>
</section></main>
<%- include('../partials/footer') %>
